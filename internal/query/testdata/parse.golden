query: {service="api"}
canon: {service="api"}

query: {service="api", env="prod"}
canon: {service="api", env="prod"}

query: {service="api",}
canon: {service="api"}

query: {service=~"api|web", env!="dev"}
canon: {service=~"api|web", env!="dev"}

query: {service=`a"b`}
canon: {service="a\"b"}

query: {service="api"} |= "timeout"
canon: {service="api"} |= "timeout"

query: {service="api"} |= "timeout" != "healthcheck" |~ "5\\d\\d" !~ "GET /ping"
canon: {service="api"} |= "timeout" != "healthcheck" |~ "5\\d\\d" !~ "GET /ping"

query: {service="api"} | json
canon: {service="api"} | json

query: {service="api"} | logfmt | level="error"
canon: {service="api"} | logfmt | level = "error"

query: {service="api"} | json | level="error" | status>=500 | latency<0.25
canon: {service="api"} | json | level = "error" | status >= 500 | latency < 0.25

query: {service="api"} | json | route=~"/v1/.*" | user!="bot" | code=200 | code!=404 | n>-3
canon: {service="api"} | json | route =~ "/v1/.*" | user != "bot" | code = 200 | code != 404 | n > -3

query: {service="api"} |= "a" | json | msg !~ "x.y"
canon: {service="api"} |= "a" | json | msg !~ "x.y"

query: {service="api"} | json = "x"
canon: {service="api"} | json = "x"

